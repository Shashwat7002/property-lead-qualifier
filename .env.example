# Sprint Lead Generation — environment template (P0-03)
# Copy to ".env" (gitignored) and fill in, OR set these as real environment variables.
# You can also configure these from the in-app Settings panel (writes local_settings.json).

DEMO_MODE=true

# First MLS (FMLS) RESO Web API
FMLS_API_KEY=
FMLS_USERNAME=
FMLS_PASSWORD=

# Enrichment APIs (free registration)
FRED_API_KEY=
CENSUS_API_KEY=

# GSCCCA deed index (free account at gsccca.org/register)
GSCCCA_USERNAME=
GSCCCA_PASSWORD=

# Optional: override per-submarket price ceiling with a single int
FMLS_PRICE_CEILING=
